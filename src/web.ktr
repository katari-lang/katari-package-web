// Page fetch over the prelude's `http.fetch`. No capability: it reads public pages.
//
// A non-2xx throws rather than returning the error as text, so the AI loop reports `tool_failed`
// instead of a `tool_succeeded` for a page nobody read.

@"Tool: fetch a web page over HTTP GET and return its body text, cut to @max_characters@ code points
(the budget covers the whole answer, and a cut page says how long the page really was). A non-2xx
status throws `http.api_failure` — `http.auth_error` for 401 / 403, `http.api_error` otherwise, each
carrying the status and the server's own body; a request that never completes throws
`http.fetch_error`."
agent fetch_page(
  @"The page URL." url: string,
  @"The budget for the whole answer, in code points." max_characters: integer ?= 16000,
) -> string {
  let response = http.fetch(url = url)
  if (response.status >= 200 && response.status < 300) {
    // `string.fit` pays for the marker out of the budget, so the marker names the page's real length
    // rather than how much of it is shown.
    string.fit(
      value = response.body,
      cap = max_characters,
      marker = f"\n[… TRUNCATED: this is the opening of a ${string.length(value = response.body)}-character page, cut to a ${max_characters}-character budget; the rest was not fetched. Treat this as a fragment, and say so rather than answering as if you had the whole page.]",
    )
  } else {
    prelude.throw(error = http.classify_status(status = response.status, context = f"web.fetch_page ${url}", message = response.body))
  }
}
